        "from sklearn.pipeline import make_pipeline\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.metrics import accuracy_score, classification_report\n",
        "\n",
        "# Separación cronológica\n",
        "corte = int(len(X) * 0.80)\n",
        "\n",
        "X_train = X.iloc[:corte]\n",
        "X_test = X.iloc[corte:]\n",
        "\n",
        "y_train = y.iloc[:corte]\n",
        "y_test = y.iloc[corte:]\n",
        "\n",
        "# Crear el modelo\n",
        "modelo = make_pipeline(\n",
        "    StandardScaler(),\n",
        "    LogisticRegression(max_iter=1000)\n",
        ")\n",
        "\n",
        "# Entrenar\n",
        "modelo.fit(X_train, y_train)\n",
        "\n",
        "# Evaluar\n",
        "predicciones = modelo.predict(X_test)\n",
        "\n",
        "print(\"RESULTADOS DEL PRIMER MODELO\")\n",
        "print(\"Exactitud:\", round(accuracy_score(y_test, predicciones) * 100, 2), \"%\")\n",
        "\n",
        "print(\"\\nReporte de clasificación:\")\n",
        "print(classification_report(y_test, predicciones, zero_division=0))"
