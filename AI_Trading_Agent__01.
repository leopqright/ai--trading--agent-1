        "# 3. Preparar las características del modelo\n",
        "\n",
        "df[\"Distancia_20\"] = (df[\"Close\"] / df[\"Media_20\"]) - 1\n",
        "df[\"Distancia_50\"] = (df[\"Close\"] / df[\"Media_50\"]) - 1\n",
        "\n",
        "df[\"Cambio_volumen\"] = df[\"Volume\"].pct_change()\n",
        "\n",
        "# Seleccionar las variables que aprenderá el modelo\n",
        "caracteristicas = [\n",
        "    \"Retorno_diario\",\n",
        "    \"Distancia_20\",\n",
        "    \"Distancia_50\",\n",
        "    \"Cambio_volumen\"\n",
        "]\n",
        "\n",
        "# Eliminar registros incompletos\n",
        "modelo_df = df.dropna(\n",
